pkgname=vamp-http-audit
_pyname=vamp_http_audit
pkgver=1.7.0
pkgrel=1
pkgdesc='HTTP security headers and CORS auditor covering CSP, HSTS, X-Frame-Options, Referrer-Policy and Permissions-Policy — bilingual EN/ES output'
groups=('blackarch' 'blackarch-scanner' 'blackarch-webapp')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-http-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('d1cac7dfde6dd5d4a73d0f341c3bafe03ae947eabaa25b799a3c15c9ca26f79c18123b9333d60155515b898c03940d3047553670124e6f1cdd7f43e20dad3e8e')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

