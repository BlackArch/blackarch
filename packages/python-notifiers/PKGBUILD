pkgname=python-notifiers
_pkgname=${pkgname#python-}
pkgver=2.0.0
pkgrel=1
pkgdesc='The easy way to send notifications.'
arch=('any')
url='https://pypi.org/project/notifiers/#files'
license=('MIT')
depends=('python' 'python-click' 'python-jsonschema' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel' 'python-hatchling')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('1719dbf088df0b1404f8af50de88f05fe6bc988d767624f3fa8b2bb2bb468eadef2cdff95b50ef2ec0175f8212fe789ae40cc7c3976c406d4090d2123d9da8dd')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

