pkgname=python-httpx-socks
_pkgname=httpx_socks
pkgver=0.13.1
pkgrel=1
pkgdesc='Proxy (HTTP, SOCKS) transports for httpx.'
url='https://pypi.org/project/httpx-socks/#files'
arch=('any')
license=('Apache-2.0')
depends=('python' 'python-httpx' 'python-python-socks')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('4737507d839ba5687e1375bdf67348a1e0eee705e43634cd5b89a73f9883b377c223596af7d529031174fc3ea6746c02e8ae25d1fe41182b0e5e45019efd9708')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

