pkgname=python-google-resumable-media
_pkgname=google_resumable_media
pkgver=2.11.0
pkgrel=1
pkgdesc='Utilities for Google Media Downloads and Resumable Uploads.'
arch=('any')
url='https://pypi.org/project/google-resumable-media/#files'
license=('Apache-2.0')
depends=('python' 'python-google-crc32c')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('c445a96ed5775d74cfac5942c99395409efb61f78e411377aa32f429f984fd4092d9c3491d6395d5a43a104198b73bd33b3590ebb36599fca02387193a582a97')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

