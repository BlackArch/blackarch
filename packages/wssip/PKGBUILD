# See COPYING for license details.

pkgname=wssip
pkgver=1.1.0.r14.g56d0d2c
pkgrel=1
epoch=1
pkgdesc='Application for capturing, modifying and sending custom WebSocket data from client to server and vice versa.'
arch=('any')
groups=('blackarch' 'blackarch-webapp' 'blackarch-proxy')
url='https://github.com/nccgroup/wssip'
license=('AGPL-3.0-or-later')
depends=('nodejs' 'coffee-script' 'electron')
makedepends=('git' 'npm' 'python' 'python2' 'libxtst')
source=("git+https://github.com/nccgroup/$pkgname.git")
sha512sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v\([0-9]\)/\1/;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

package() {
  cd $pkgname

  local _npmdir="$pkgdir/usr/lib/node_modules"

  install -dm 755 "$_npmdir"

  npm install -g --prefix "$pkgdir/usr" --cache "$srcdir/npm-cache" \
    --no-audit --no-fund wssip@

  rm -f "$_npmdir/.package-lock.json"

  sed -i "s|^\( *\)require('electron'),$|\1'/usr/bin/electron',|" \
    "$_npmdir/wssip/lib/main.js"

  sed -i "s|^\( *\)show: false$|\1show: false,\n\1webPreferences: {nodeIntegration: true, contextIsolation: false}|" \
    "$_npmdir/wssip/lib/electron.js"

  grep -q "/usr/bin/electron" "$_npmdir/wssip/lib/main.js" &&
    grep -q "nodeIntegration" "$_npmdir/wssip/lib/electron.js" ||
      { echo "electron patches did not apply" >&2; return 1; }

  find "$pkgdir/usr" -type d -exec chmod 755 {} +
  chown -R root:root "$pkgdir"
}

