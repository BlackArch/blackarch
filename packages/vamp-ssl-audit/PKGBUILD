pkgname=vamp-ssl-audit
_pyname=vamp_ssl_audit
pkgver=1.9.0.0
pkgrel=1
pkgdesc='TLS/SSL security auditor for protocol version, cipher suites, certificate validity and HSTS preload checking — bilingual EN/ES output'
groups=('blackarch' 'blackarch-scanner' 'blackarch-crypto')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-ssl-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-cryptography' 'python-rich' 'python-dnspython')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('bc9253c354f71eeaa53f518118f86d9ad9d473b6d2d9a7604238c94ce1c2ced13c2e3101370fa00dde893e0569b7780de36fcb42b138b715b0a67f895f39f72b')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

