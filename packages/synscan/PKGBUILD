pkgname=synscan
pkgver=5.02
pkgrel=8
pkgdesc='Fast asynchronous half-open TCP portscanner.'
url='https://www.digit-labs.org/files/tools/synscan/'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-scanner')
license=('GPL-2.0-or-later')
depends=('libpcap')
source=("https://www.digit-labs.org/files/tools/$pkgname/releases/$pkgname-$pkgver.tar.gz")
sha512sums=('40ec616e169d0d4150e2213fbdcb985e55dcceefef521b0bf85d8964f5b82892b8abeffcbe9c5e38314c22b86553dae56fb082d546e83efa65755a4d345ea7b0')

build() {
  cd "$pkgname-$pkgver"

  ./configure --prefix=/usr

  make linux
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm 755 sslog "$pkgdir/usr/bin/sslog"
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

