# See COPYING for license details.

pkgname=helix-osint
_pkgname=helix_osint
pkgver=3.5.0
pkgrel=1
pkgdesc='OSINT username checker that verifies every hit live and maps how the accounts connect.'
groups=('blackarch' 'blackarch-social' 'blackarch-recon')
arch=('any')
url='https://github.com/thalha-a9/helix'
license=('MIT')
depends=('python' 'python-aiohttp')
optdepends=('python-aiohttp-socks: --tor and socks5:// proxies'
            'python-curl_cffi: TLS impersonation for X, Instagram and TikTok'
            'python-imagehash: avatar matching (--phash)'
            'python-pillow: avatar matching (--phash)'
            'holehe: email account check (--holehe)'
            'python-weasyprint: PDF reports (--report)')
makedepends=('python-build' 'python-pip' 'python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/$pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('c05fc8d1cfa8a7d228b2b59687e09e7b6aa7b1cd846a0aa9c323ba919903429fdaa98b046f099b99e7853aa4d4446f80704e9888cf47f42be6baea46ade87b16')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation --outdir="$srcdir/dist"
}

package() {
  cd "$_pkgname-$pkgver"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$srcdir/dist" \
    $pkgname

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md CHANGELOG.md
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # /usr/bin/helix belongs to the Helix text editor (extra/helix).
  rm -f "$pkgdir/usr/bin/helix"
}
