pkgname=python-pysqlite3
_pkgname=pysqlite3
pkgver=0.6.1
pkgrel=1
pkgdesc='DB-API 2.0 interface for Sqlite 3.x.'
arch=('x86_64' 'aarch64')
url='https://pypi.org/project/pysqlite3/#files'
license=('zlib/libpng')
depends=('python' 'sqlite')
makedepends=('python-installer' 'python-setuptools' 'python-build' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('01532087ed5b4c8b61c3ef6030c450f4337543ccc6cebeb9f9293c32fae99a355cb8781acf7f7152ef05ece06660a5fc8fe741510cc63342434f0dcbd9177b01')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="pkgdir" dist/*.whl
}

