
# This file is part of BlackArch Linux ( https://www.blackarch.org/ ).
# See COPYING for license details.

pkgname=mcbotscan
pkgver=2.1.0
pkgrel=1
pkgdesc='Behavior-aware static Android malware and APK risk scanner'
arch=('any')
groups=('blackarch' 'blackarch-mobile' 'blackarch-malware' 'blackarch-scanner')
url='https://github.com/mcbottm/MCBOTSCAN'
license=('BSD-3-Clause')
depends=('python' 'python-pyyaml' 'android-apktool')
optdepends=('python-yara: optional YARA rule engine integration')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('e932f0442112f711316e707f1b3a49db98e60c15cdcd0ffed18be13177ec1f95c0a70fdeeeb53a64d0a921d9a0cab3f35bf3672689094061994ee54fcc6b7f32')

build() {
  cd "MCBOTSCAN-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "MCBOTSCAN-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

