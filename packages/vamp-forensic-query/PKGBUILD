pkgname=vamp-forensic-query
_pyname=vamp_forensic_query
pkgver=1.3
pkgrel=1
pkgdesc='Forensic SQL and log query engine for authorized digital investigations with chain-of-custody evidence output'
groups=('blackarch' 'blackarch-forensic')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-forensic-query'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('fe1fbb35d1b1d6c0067b96bde7e545a63d652f2af7802ac3f3bb9d28ed01799dd2e21d65db388550cb2edf2f087e474175fefac97d4bad3e4bdcd4404bababf1')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

