pkgname=python-libluksde-python
_pkgname=libluksde-python
pkgver=20260902
pkgrel=1
pkgdesc='Python bindings module for libluksde.'
url='https://pypi.org/project/libluksde-python/'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('6c5344d9e2a7d4a7a20165ad0a897601ed0e0a88ef568d0d5756475814cea54d687091833532127500a075185b7cd40cfa2310592b934261c7c93572950cfc07')

build() {
  cd "libluksde-$pkgver"

  python setup.py build
}

package() {
  cd "libluksde-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

