# See COPYING for license details.

pkgname=iotaudit
pkgver=0.1.26.r0.g39417e6
pkgrel=1
pkgdesc='Audit smart home devices on your own network: destinations, plaintext vs TLS, open ports, default logins, UPnP and an A-F grade.'
arch=('any')
groups=('blackarch' 'blackarch-networking' 'blackarch-scanner')
url='https://github.com/emirmrkaljevic/iotaudit'
license=('MIT' 'CC-BY-4.0')
depends=('python' 'scapy' 'python-jinja' 'python-yaml' 'python-maxminddb')
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling')
optdepends=('nmap: open port scans'
            'tcpdump: live capture in iotaudit auto')
source=("git+https://github.com/emirmrkaljevic/$pkgname.git")
sha512sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd $pkgname

  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" *.md
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm 644 src/$pkgname/data/NOTICE \
    "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
