pkgname=python-url-normalize
_pkgname=url_normalize
pkgver=3.1.0
pkgrel=1
pkgdesc='URL normalization for Python.'
arch=('any')
url='https://pypi.org/project/url-normalize/#files'
license=('custom:unknown')
depends=('python' 'python-six' 'python-idna')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('505a4ee76a394fc315d56b948a1597b38921b0af1d8fbb13f521d9851599f3bc3238a39c17c6043780561f64966bfa21aee23eed22d0ba023ec280bd39f9eedc')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

