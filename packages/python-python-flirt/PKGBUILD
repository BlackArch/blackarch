pkgname=python-python-flirt
_pkgname=python_flirt
_pyver=3.14
pkgver=0.10.2
pkgrel=1
pkgdesc='A Python library for parsing, compiling, and matching Fast Library Identification and Recognition Technology (FLIRT) signatures.'
arch=('x86_64')
url='https://pypi.org/project/python-flirt/#files'
license=('Apache-2.0')
depends=('python')
source=("https://files.pythonhosted.org/packages/45/21/05b5702f1fb7e6c582fa1b7c1f5154e17b9db3559aa76a5b32a81df79705/$_pkgname-$pkgver-cp${_pyver//./}-cp${_pyver//./}-manylinux_2_17_x86_64.manylinux2014_x86_64.whl")
sha512sums=('2633bbabd13851839e1f2189edb10cd39c0bc69860c65a3d8a4f96f17907410e7b314f685d9901f2d13d990dca20aa31696455090ec81c91a70123157e1ff735')

package() {
  install -Dm 755 -t "$pkgdir/usr/lib/python$_pyver/site-packages/" \
    "flirt/flirt.cpython-${_pyver//./}-x86_64-linux-gnu.so"

  cp -a "$_pkgname-$pkgver.dist-info" \
    "$pkgdir/usr/lib/python$_pyver/site-packages/"
}

