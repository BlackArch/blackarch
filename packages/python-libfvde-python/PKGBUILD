pkgname=python-libfvde-python
_pkgname=libfvde
pkgver=20260923
pkgrel=1
pkgdesc='Library and tools to access FileVault Drive Encryption (FVDE) encrypted volumes.'
url='https://pypi.org/project/libfvde-python/#files'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('48387cad1eb0dd3fc0c09146b0573e3b2a23e7ad54ecfedfc1f4901fb412aad5cad4b1a3d44b8af054ed4ed94892f2ff172eeb49f8a549a05ff3c71228eca34a')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

