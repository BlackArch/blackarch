pkgname=ddosify
pkgver=2.4.0.r0.g34bbca1
pkgrel=1
epoch=2
pkgdesc='High-performance load testing tool, written in Golang.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-dos' 'blackarch-misc')
url='https://github.com/ddosify/ddosify'
license=('AGPL')
depends=('glibc')
makedepends=('git' 'go')
source=("git+https://github.com/ddosify/$pkgname.git")
sha256sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v\([0-9]\)/\1/;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd "$pkgname/${pkgname}_engine"

  GOPATH="$srcdir" go mod download
  GOPATH="$srcdir" go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-s -w" \
    -o $pkgname .

}

package() {
  cd "$pkgname/${pkgname}_engine"

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" "$srcdir/$pkgname/"*.md

  install -Dm 644 "$srcdir/$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

