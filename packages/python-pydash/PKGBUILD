pkgname=python-pydash
_pkgname=pydash
pkgver=8.1.0
pkgrel=1
pkgdesc='TPython utility libraries for doing stuff in a functional way based on the Lo-Dash Javascript library.'
arch=('any')
url='https://pypi.org/project/pydash/#files'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-pip')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('9f08bc91fd6a4d69e7087f5ecb77800bff25d03417dab06f6460200f87b7560c84185bb0d72bd860ba8406eb9d96244eef96436122168ff257e52711663eedc4')

build() {
  cd $_pkgname-$pkgver

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd $_pkgname-$pkgver

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $_pkgname
}

