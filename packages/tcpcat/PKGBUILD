pkgname=tcpcat
pkgver=v1.3.0.r2.g8aa075f
pkgrel=1
groups=('blackarch' 'blackarch-scanner' 'blackarch-networking')
pkgdesc='High-performance network reconnaissance and vulnerability intelligence scanner with an eBPF/AF_XDP engine.'
arch=('x86_64' 'aarch64')
url='https://github.com/NycolazSec/tcpcat'
license=('Apache-2.0')
depends=('iputils')
makedepends=('git' 'go')
source=("git+https://github.com/NycolazSec/$pkgname.git")
sha512sums=('SKIP')

pkgver() {
  cd "$pkgname"

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd "$pkgname"

  export CGO_ENABLED=0
  GOPATH="$srcdir" go mod download
  GOPATH="$srcdir" go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-s -w" \
    -o "$pkgname" ./cmd/$pkgname
}

package() {
  cd "$pkgname"

  install -Dm 755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm 644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
