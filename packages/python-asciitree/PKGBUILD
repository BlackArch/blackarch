pkgname=python-asciitree
_pkgname=asciitree
pkgver=1.0.0
pkgrel=1
pkgdesc='Draws ASCII trees.'
arch=('any')
url='https://pypi.org/project/asciitree/#files'
license=('MIT')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('2c7e5ffe50c3588e4e131ea096cce2aaa78620cd807970cee5c174eb5d456c39cf3277d7ed69af154bc5c5187d73c313d1810c04f5c7c034ffc197ce8af8f278')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

