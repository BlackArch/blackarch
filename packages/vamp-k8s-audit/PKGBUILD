pkgname=vamp-k8s-audit
_pyname=vamp_k8s_audit
pkgver=3.3.0
pkgrel=1
pkgdesc='Kubernetes cluster security auditor for authorized assessments — RBAC, pod security, network policies and secret exposure'
groups=('blackarch' 'blackarch-scanner' 'blackarch-cloud')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-k8s-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('800865bd4fef9c7e64f860142c0bf0460939b2d5915b617da21d66e4790c3bca9670f26d5db318516d3e83f6995dbfec6a8e6eb7a3e409fbeabf8a445f31b906')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
