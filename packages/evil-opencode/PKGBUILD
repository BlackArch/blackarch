# See COPYING for license details.

pkgname=evil-opencode
pkgver=1.18.35
pkgrel=1
_pkgtag="v${pkgver}-unguarded"
pkgdesc='OpenCode coding-agent fork with LLM prompt guardrails removed and outbound telemetry disabled.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-ai')
url='https://github.com/winmin/evil-opencode'
license=('MIT')
depends=('glibc' 'gcc-libs' 'ripgrep')
makedepends=('bun')
provides=('opencode')
conflicts=('opencode')
options=('!strip' '!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_pkgtag.tar.gz")
sha512sums=('a4538e9e283e8eb95cfeab67edae8cd38b6ce3ff86d93d59321fa6388b9b28849b09b7259810c9055ac8ce379e0acde895c6b2cb497a965dbb68d46a40dc1ac8')

prepare() {
  cd "$pkgname-$pkgver-unguarded"

  rm -rf packages/console packages/stats packages/enterprise

	sed -i 's/throw new Error(`This script requires bun/console.warn(`(relaxed) requires bun/' \
		packages/script/src/index.ts || true
}

build() {
  cd "$pkgname-$pkgver-unguarded"

  export OPENCODE_VERSION="$pkgver"

  bun install

  cd packages/opencode
  bun run script/build.ts --single --skip-embed-web-ui
}

package() {
  cd "$pkgname-$pkgver-unguarded/packages/opencode"

  local _barch
  case "$CARCH" in
    x86_64)  _barch='x64'   ;;
    aarch64) _barch='arm64' ;;
  esac

	install -Dm 755 "dist/opencode-linux-${_barch}/bin/opencode" \
		"$pkgdir/usr/bin/opencode"

	install -Dm 644 ../../LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

