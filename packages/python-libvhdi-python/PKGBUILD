pkgname=python-libvhdi-python
_pkgname=libvhdi
__pkgname=libvhdi-python
pkgver=20260901
pkgrel=1
pkgdesc='Library and tools to access the Virtual Hard Disk (VHD) image format.'
url='https://pypi.org/project/libvhdi-python/'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$__pkgname/$__pkgname-20210425.tar.gz")
sha512sums=('31aa99294b2781a9c611ab5462a8ad63d6ed96478eabc433b90b4cb88bfd0e8e19612e9d5790be93e10ad7c84587799b06553ab5a13df11881d5bc02b8a51c76')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

