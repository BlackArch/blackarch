pkgname=python-libfsapfs-python
_pkgname=libfsapfs-python
pkgver=20261030
pkgrel=1
pkgdesc='Library and tools to access the Apple File System (APFS).'
url='https://pypi.org/project/libfsapfs-python/#files'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('b6d28ae9252b87cddf6044a45919b8f6d8b6eb785f924472e39e15d99293971882a494f8603038586b19f33ae3c47073b8f3d58fed0bb5dd0928f5bd21b545e7')

build() {
  cd "libfsapfs-$pkgver"

  python setup.py build
}

package() {

  cd "libfsapfs-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

