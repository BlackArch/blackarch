pkgname=python-libvshadow-python
_pkgname=libvshadow
pkgver=20260714
pkgrel=1
pkgdesc='Library and tools to access the Volume Shadow Snapshot (VSS) format.'
arch=('x86_64' 'aarch64')
url='https://pypi.org/project/libvshadow-python/#files'
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-python-$pkgver.tar.gz")
sha512sums=('2c888605a98917edbab8e8f4fef6b3132064f399d007bec5d5db2374c6cef1a2711529ddbbfb43ade894d09d6ef05b535d6b672ff60b486ee89b9e203da8e1d4')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

