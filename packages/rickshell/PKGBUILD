pkgname=rickshell
_pkgname=RickShell
pkgver=3.4.1
pkgrel=1
pkgdesc='Modular Python C2 framework — generate, encode, catch, and interact with reverse shells.'
arch=('any')
groups=('blackarch' 'blackarch-exploitation')
url='https://github.com/Rickidevs/RickShell'
license=('MIT')
depends=('python' 'python-psutil')
source=("https://github.com/Rickidevs/$_pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('ae9fc4c7edb8c7a26dbaf18869013686473da9d31dcda720e33766d2c8df5aa1adce71a340fb8b1b96a45db20c4ea113f3ae8f14e827217249b1999bc035a3aa')

package() {
  cd $_pkgname-$pkgver

  install -dm 755 "$pkgdir/usr/bin"
  install -dm 755 "$pkgdir/usr/share/$pkgname"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" *.md

  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  rm -rf LICENSE *.md .gitignore

  cp -a * "$pkgdir/usr/share/$pkgname/"

  cat > "$pkgdir/usr/bin/$pkgname" << EOF
#!/bin/sh
exec python /usr/share/$pkgname/rickshell.py "\$@"
EOF

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

