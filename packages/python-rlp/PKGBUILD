pkgname=python-rlp
_pkgname=rlp
pkgver=5.0.0
pkgrel=1
pkgdesc='A package for Recursive Length Prefix encoding and decoding.'
url='https://pypi.org/project/rlp/#files'
arch=('any')
license=('MIT')
depends=('python' 'python-eth-utils')
makedepends=('python-setuptools' 'python-setuptools-markdown')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('9f2370bbbb75e378c6a34f792fd258253f0dc9027072919167b393fa798f88d65d9a7735fcb3b02f7e7f80482ffa1cf05d29fd62c96587ac41ee42976ad0de37')

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1
}

