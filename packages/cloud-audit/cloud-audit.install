post_upgrade() {
  set -e
  cd /usr/share/cloud-audit
  source venv/bin/activate &&
    pip install --isolated --root=/usr/share/cloud-audit --prefix=venv \
      cloud-audit -U
}

post_remove() {
  # The venv folder is untracked by pacman, so clean it up on removal.
  rm -rf /usr/share/cloud-audit
}
