pkgname=python-iso3166
_pkgname=iso3166
pkgver=3.0.0
pkgrel=1
pkgdesc='Self-contained ISO 3166-1 country definitions.'
arch=('any')
url='https://pypi.org/project/iso3166/#files'
license=('MIT')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('c348569870a19bcdb08b702848303e907e84dbbeb5c357041334870ee189453bed523369abd5ed43ffbc138567f0c76976e4c05d8461e7293cd9f4e5028ab95a')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

