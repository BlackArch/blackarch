pkgname=python-asn1tools
_pkgname=asn1tools
pkgver=0.169.0
pkgrel=1
pkgdesc='ASN.1 parsing, encoding and decoding.'
arch=('any')
url='https://pypi.org/project/asn1tools/#files'
license=('MIT')
depends=('python' 'licenses' 'python-prompt_toolkit' 'python-diskcache'
         'python-bitstruct')
makedepends=('python-pip' 'python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('ac65598d95fdbdbe5124fdd9f4441eac41e6564390ae7ad98a441e417b8b97fd0fcf0330b9449d8e9b117def7b037f50005d5d5be65b8307771d253e7eeb19f6')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

