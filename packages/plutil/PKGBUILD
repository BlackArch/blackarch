# See COPYING for license details.

pkgname=plutil
pkgver=1.6
pkgrel=5
pkgdesc='Converts .plist files between binary and UTF-8 (editable) text formats.'
arch=('any')
groups=('blackarch' 'blackarch-misc')
url='http://scw.us/iPhone/plutil/'
license=('custom:unknown')
depends=('perl')
makedepends=('dos2unix')
source=("$pkgname.pl")
sha512sums=('2de3bdbf56e05dbefd359c18d00ab60137e1c5c961eb1a8700a41da5ca14a1af9717fd5a40b9dffa675d18cd06ca75f4f2f2ab9af551d16564abc2d5dbdec797')

prepare() {
  sed -i '1i\#!/usr/bin/perl' "$pkgname.pl"

  dos2unix "$pkgname.pl"
}

package() {
  # NOTE: installed as plutil.pl, not plutil. gnustep-base ships an unrelated
  # /usr/bin/plutil.
  install -Dm 755 "$pkgname.pl" "$pkgdir/usr/bin/$pkgname.pl"
}

