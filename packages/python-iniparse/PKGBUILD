pkgbase=python-iniparse
pkgname=('python2-iniparse' 'python-iniparse')
_pkgname=iniparse
pkgver=0.5.2
pkgrel=1
pkgdesc='Accessing and Modifying INI files.'
arch=('any')
url='https://pypi.org/project/iniparse/'
license=('MIT')
makedepends=('python2-setuptools' 'python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('e64a32ab1f171d0f4baf758a54b96b4037f437606761a7b12c3c69613dc8798f11aef6e7f12e274ab4a03a9747f3ac7309a10ed12e307fc7dc8412465680649f')

prepare() {
  cp -a "$_pkgname-$pkgver"{,-2}
}

build() {
  cd "$_pkgname-$pkgver-2"

  python2 setup.py build

  cd "$srcdir/$_pkgname-$pkgver"

  python setup.py build
}

package_python2-iniparse() {
  depends=('python2')

  cd "$_pkgname-$pkgver-2"

  python2 setup.py install --prefix=/usr --root="$pkgdir" --optimize=1 \
    --skip-build
}

package_python-iniparse() {
  depends=('python')

  cd "$_pkgname-$pkgver"

  python setup.py install --prefix=/usr --root="$pkgdir" --optimize=1 \
    --skip-build
}

