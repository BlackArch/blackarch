pkgname=perl-crypt-ssleay
_pkgname=Crypt-SSLeay
pkgver=0.73_06
pkgrel=10
pkgdesc='OpenSSL glue that provides LWP https support.'
arch=('x86_64' 'aarch64')
url='https://search.cpan.org/dist/Crypt-SSLeay'
license=('GPL-2.0-or-later' 'Artistic-1.0-Perl')
depends=('perl' 'perl-lwp-protocol-https' 'perl-try-tiny' 'perl-path-class'
         'perl-bytes-random-secure')
makedepends=('perl-devel-checklib')
options=('!emptydirs')
source=("https://www.cpan.org/CPAN/authors/id/N/NA/NANIS/$_pkgname-$pkgver.tar.gz"
        "ossl1.1.patch")
sha512sums=('8e1ae0466f009a1f1c4acd7d85e9aece27c2b65f1fc704ffe9355ede5e6bfd8838d5c82cb5906f6109a1a437b615e9a94b7e3a0fdbae91b1ed074d17fb5471aa'
            'c5502198ce99458e639a0603bd702f22e527f24edb613ab39d7c49aa742245ccab02b579469ec6a9d9581e36c1cf6350171248a9ea40796e920533a274aa2490')

prepare() {
  cd "$_pkgname-$pkgver"

  patch -p1 < "$srcdir/ossl1.1.patch"
}

build() {
  cd  "$_pkgname-$pkgver"

  PERL_USE_UNSAFE_INC=1 \
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

  make
}

package() {
  cd  "$_pkgname-$pkgver"

  make install DESTDIR="$pkgdir"

}

