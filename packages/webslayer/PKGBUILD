# See COPYING for license details.

pkgname=webslayer
pkgver=5
pkgrel=11
pkgdesc='A tool designed for brute forcing Web Applications.'
arch=('any')
groups=('blackarch' 'blackarch-webapp')
url='https://code.google.com/archive/p/webslayer/'
license=('LGPL-3.0-or-later')
depends=('python2-pycurl' 'python2-pyqt4')
source=("https://storage.googleapis.com/google-code-archive-source/v2/code.google.com/webslayer/source-archive.zip")
sha512sums=('e4d3f9c772eee56c6c0c37dcdfde4bdfd00b3d5a861a1d6d62515bddeae2d946a6c855d72d00c1126f2037e221c6247bc7eb11f7bbcbf833d20169dec47e55ec')

prepare() {
  cd $pkgname/trunk

  sed -i 's|bin/python$|bin/python2|' *.py
}

package() {
  cd $pkgname/trunk

  install -dm 755 "$pkgdir/usr/bin"
  install -dm 755 "$pkgdir/usr/share/$pkgname"
  install -dm 755 "$pkgdir/usr/share/doc/$pkgname"

  cp -R --no-preserve=ownership * "$pkgdir/usr/share/$pkgname/"

  rm "$pkgdir/usr/share/webslayer"/{COPYING,LICENSES}

  mv "$pkgdir/usr/share/$pkgname/README" "$pkgdir/usr/share/doc/$pkgname"

  cat > "$pkgdir/usr/bin/$pkgname" << EOF
#!/bin/sh
cd /usr/share/$pkgname
exec ./WebSlayer.py "\$@"
EOF

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

