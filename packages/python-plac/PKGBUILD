pkgname=python-plac
_pkgname=plac
pkgver=1.4.7
pkgrel=1
pkgdesc='Python package that can generate command line parameters from function signatures.'
arch=('any')
url='https://pypi.org/project/plac/'
license=('BSD')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('36086f4f13071ea691f8d1f78443c02eacb35c8040b64891b552f85695e5021c6eeb028ba23fba9df397c4ffad645e4921deb6c8e08098a91fc2daf5cff23b57')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build

  for s in "$pkgdir/usr/bin/"*;do
    arrS=(${s//./ })
    mv $s "${arrS[0]}"
  done
}

