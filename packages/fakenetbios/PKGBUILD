# See COPYING for license details.

pkgname=fakenetbios
pkgver=7.b83701e
pkgrel=3
pkgdesc='A family of tools designed to simulate Windows hosts (NetBIOS) on a LAN.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-spoof' 'blackarch-honeypot' 'blackarch-networking')
url='https://github.com/mubix/FakeNetBIOS'
license=('custom')
makedepends=('git')
source=("$pkgname::git+https://github.com/mubix/FakeNetBIOS.git")
sha512sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v\([0-9]\)/\1/;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build(){
  cd "$pkgname/Sources"

  make -f Makefile.linux
}

package() {
  cd $pkgname

  install -Dm 755 Sources/FakeNetbiosDGM "$pkgdir/usr/bin/fakenetbiosdgm"
  install -Dm 755 Sources/FakeNetbiosNS  "$pkgdir/usr/bin/fakenetbiosns"
  install -Dm 644 License.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  rm License.txt

  for i in `ls *.txt` ; do
    install -Dm 644 $i "$pkgdir/usr/share/doc/$pkgname/$i"
  done
}

