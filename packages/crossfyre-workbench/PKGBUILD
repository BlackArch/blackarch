pkgname=crossfyre-workbench
pkgver=0.1.1
pkgrel=1
pkgdesc='Local intercepting proxy and manual testing workbench.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-proxy' 'blackarch-webapp')
url='https://crossfyre.io/workbench'
license=('LicenseRef-Crossfyre-Workbench-EULA')
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libgcc'
         'libsoup3' 'webkit2gtk-4.1')
optdepends=('nss: certutil, to add the CA to Chrome and Chromium'
            'xdg-utils: opening the browser to sign in')
options=(!strip !debug)
source_x86_64=("https://bins.crossfyre.io/workbench/v$pkgver/$pkgname-v$pkgver-linux-x86_64.tar.gz")
source_aarch64=("https://bins.crossfyre.io/workbench/v$pkgver/$pkgname-v$pkgver-linux-aarch64.tar.gz")
sha512sums_x86_64=('e32460baebff0737e554aa0006c26b5e008d17c7c8dcdb128ab2e54fd574405d8c88004acceea2994786b248d4a032fcf459f961e6bba43bc8fd38e5ada625e1')
sha512sums_aarch64=('59646cd53f10f59f3343ea1f7e47d4dafdce7d60e6464d8e6f4b7a1a8ca73d7b3921a4ece7eceaaf3da88cab9783872c32d3da990809d6fccae227ae851f04c7')

package() {
  cd "$pkgname-v$pkgver-linux-$CARCH"

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 $pkgname.desktop \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm 644 $pkgname.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"

  install -Dm 644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE.txt \
    THIRD-PARTY-NOTICES
}
