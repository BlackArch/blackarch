pkgname=python-azure-mgmt-sql
_pkgname=azure-mgmt-sql
pkgver=4.0.0
pkgrel=1
pkgdesc='Microsoft Azure SQL Management Client Library for Python.'
arch=('any')
url='https://pypi.org/project/azure-mgmt-sql/#files'
license=('MIT')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.zip")
sha512sums=('fc0610458070c0832297701086a011991e30d23fb1e06dd59a9e2f58091ee8d5e8119e8bf158ad862e49784538be19f1013a2c6af25f850f33d6d8250f8d92f9')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --prefix=/usr --root="$pkgdir" --optimize=1 \
    --skip-build
}

