pkgname=memfetch
pkgver=1.02
pkgrel=1
pkgdesc='Dumps any userspace process memory without affecting its execution.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-forensic')
url='https://lcamtuf.coredump.cx/'
license=('GPL-2.0-or-later')
makedepends=('make')
depends=('glibc')
source=("https://lcamtuf.coredump.cx/soft/$pkgname.tgz")
sha512sums=('91a3eeff0f3acb52b7b3a039ea0610f8c0a01f7502048a62a297ba98f2ecb6d1a46fe3cb9b5b533ad2d310252ee50adbafd0de905ea776df0600be14b536505d')

build() {
  cd $pkgname

  make CFLAGS="$CFLAGS -Wall -DVERSION=\\\"$pkgver\\\"" LDFLAGS="$LDFLAGS"
}

package(){
  cd $pkgname

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 README.txt "$pkgdir/usr/share/doc/$pkgname/README.txt"
}

