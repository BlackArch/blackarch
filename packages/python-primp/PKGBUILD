pkgname=python-primp
_pkgname=${pkgname#python-}
pkgver=2.0.0
pkgrel=1
pkgdesc='HTTP client that can impersonate web browsers.'
arch=('any')
url='https://github.com/deedy5/primp/tree/main/crates/primp-python'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-wheel' 'python-installer' 'python-setuptools' 'python-maturin')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('c2f1ccf844506c09a3db630372fe1a938a15d531b620f6982b83274bc8fedfdb64f3c717a953948de478668cc83041736586501e62e8eb9f4c8269d269258b7c')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

