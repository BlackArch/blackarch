
# This file is part of BlackArch Linux (https://www.blackarch.org/).
# See COPYING for license details.

pkgname=torctl
pkgver=0.5.9
pkgrel=1
epoch=1
pkgdesc='Redirect system traffic through the Tor network'
arch=('x86_64')
url='https://github.com/oluxid/torctl-rs'
license=('GPL-3.0-or-later')
groups=('blackarch' 'blackarch-automation')
options=(!lto)

depends=(
  'tor'
  'systemd'
  'iptables'
  'iproute2'
  'macchanger'
  'secure-delete'
)
makedepends=('cargo')

source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/oluxid/torctl-rs/archive/refs/tags/v$pkgver.tar.gz"
)

# Generate and insert the verified checksum before submitting.
sha512sums=('3D968BCA37CFB70ECC4ED26C0EC5B4A7D950CDBF9874C68CEE41187C73B436D7557BE3F5341B42DBFAB64DE3F7D7E627D420A40BD97DA567CCFFD9ED4EB484D9')

prepare() {
  cd "$srcdir/torctl-rs-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$srcdir/torctl-rs-$pkgver"

  CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=cc \
    RUSTFLAGS="-C link-arg=-fuse-ld=bfd" \
    cargo build --frozen --release
}

check() {
  cd "$srcdir/torctl-rs-$pkgver"

  CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=cc \
    RUSTFLAGS="-C link-arg=-fuse-ld=bfd" \
    cargo test --frozen
}

package() {
  cd "$srcdir/torctl-rs-$pkgver"

  install -Dm755 target/release/torctl \
    "$pkgdir/usr/bin/torctl"

  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/torctl/README.md"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/torctl/LICENSE"

  install -Dm644 service/torctl-autostart.service \
    "$pkgdir/usr/lib/systemd/system/torctl-autostart.service"

  install -Dm644 service/torctl-autowipe.service \
    "$pkgdir/usr/lib/systemd/system/torctl-autowipe.service"

  install -Dm644 bash-completion/torctl \
    "$pkgdir/usr/share/bash-completion/completions/torctl"
}
