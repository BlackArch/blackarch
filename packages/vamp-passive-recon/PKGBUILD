pkgname=vamp-passive-recon
_pyname=vamp_passive_recon
pkgver=1.3.0
pkgrel=1
pkgdesc='Passive recon engine for subdomain enumeration, HTTP fingerprinting and GitHub dork scanning across multiple OSINT sources'
groups=('blackarch' 'blackarch-recon')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-passive-recon'
license=('AGPL-3.0-only')
depends=('python' 'python-aiohttp' 'python-rich')
makedepends=('python-build' 'python-pip' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('5aad4bb58e940d814aed068dbf90eb0359c4c3daea4c89b318d6deaad74844e42f85b5214a622d5507b9ebc2c5ec20449bd7cdaa367050d65750869f870c53fa')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd "${_pyname}-${pkgver}"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $pkgname
}

