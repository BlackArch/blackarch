pkgname=python-murmurhash
_pkgname=murmurhash
pkgver=1.0.16
pkgrel=1
pkgdesc='Cython bindings for MurmurHash2.'
arch=('x86_64' 'aarch64')
url='https://pypi.org/project/murmurhash/'
license=('MIT')
depends=('python' 'python-pytest' 'cython')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('4d0b38cc0d0126099c6e598a0d8569345b93364b564c923205437756cbdc68e8757132edbb2ec3b897efbe230943263ebdd11d5634284a904bfc410c3c92069f')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

