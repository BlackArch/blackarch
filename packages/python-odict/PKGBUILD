pkgname=python-odict
_pkgname=odict
_pyver=3.14
pkgver=2.0.1
pkgrel=1
pkgdesc='Ordered dictionary.'
arch=('any')
url='https://pypi.org/project/odict/'
license=('PSF')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('f192c2c507db477a6855df90fa5e3dd70b28ee2668b014e33be08b89df6fafb82e21c5eeadede57de00a757a84773efd60a9df7db5530752ecc8359ab6e15c4c')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build

  chmod 644 \
    "$pkgdir/usr/lib/python$_pyver/site-packages/$_pkgname-$pkgver-py$_pyver.egg-info/"*
}

