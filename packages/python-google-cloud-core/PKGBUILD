pkgname=python-google-cloud-core
_pkgname=google_cloud_core
pkgver=2.8.0
pkgrel=1
pkgdesc='Google Cloud API client core library.'
arch=('any')
url='https://pypi.org/project/google-cloud-core/#files'
license=('Apache-2.0')
depends=('python' 'python-google-api-core' 'python-google-auth'
         'python-importlib-metadata')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('4b1aded56db8850ba8223a175a61b5b1df4ac462f8354b117ee671225f2e5414c6554243c2243afea62d5ef22c039cb5f378c1c674beeb7ffa581f9de517527d')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

