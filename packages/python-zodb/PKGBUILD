pkgname=python-zodb
_pkgname=${pkgname#python-}
pkgver=6.4
pkgrel=1
pkgdesc='A native object database for Python.'
arch=('any')
url='https://pypi.org/project/ZODB/'
license=('custom:unknown')
depends=('python' 'python-persistent' 'python-zodbpickle' 'python-transaction'
         'python-btrees')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('295a62c21cf39d29603c54f520aae9f1a71f259c4c4cb7cdf4740f4c4b2161fe929fc2167d72bed41a7f4785a6b41612c7774c60b07b786b69ad552159db9dfd')

prepare() {
  cd "$_pkgname-$pkgver"

  sed -i 's|setuptools == 78.1.1|setuptools|g' pyproject.toml
}

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

