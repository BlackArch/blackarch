pkgname=python-libvslvm-python
_pkgname=libvslvm
pkgver=20260901
pkgrel=1
pkgdesc='Library and tools to access the Linux Logical Volume Manager (LVM) volume system format.'
url='https://pypi.org/project/libvslvm-python/#files'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('50a6cf2f392032524f416f57dc81a6f1d68bb78e865a8a595db6facb429597e77c8428c166cf1e2ae3c94cd8bd5ce3fc25165b90dbe7cb8962b8269601f9da87')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

