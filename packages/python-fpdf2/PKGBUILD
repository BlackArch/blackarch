pkgname=python-fpdf2
_pkgname=fpdf2
pkgver=2.8.8
pkgrel=1
pkgdesc='Simple PDF generation for Python.'
arch=('any')
url='https://github.com/py-pdf/fpdf2'
license=('LGPL-3.0-only')
depends=('python' 'python-defusedxml' 'python-pillow' 'python-fonttools')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('03b1cde2c03836d45a697e35554f036f49ebfc9e002d4da7ec581766adc4e308eccce9c6aa6820e141ec802f2212fbcbd0ece3e5f55f5d1011e8158d722404bd')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

