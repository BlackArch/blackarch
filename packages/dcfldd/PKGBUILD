pkgname=dcfldd
pkgver=1.9.3
pkgrel=1
pkgdesc='DCFL (DoD Computer Forensics Lab) dd replacement with hashing.'
groups=('blackarch' 'blackarch-forensic')
arch=('x86_64' 'aarch64')
url='https://github.com/resurrecting-open-source-projects/dcfldd/'
license=('GPL')
depends=('glibc')
source=("https://github.com/resurrecting-open-source-projects/dcfldd/archive/v$pkgver.tar.gz")
sha512sums=('de6fa32ca1bbf38da2f14c7e439b8f1020007c62f78002c4ba244937ecf70f6b2bb4bad16bdf6f50416dd091939e27acc47f087a195f3035df16efbf382ee64c')

prepare() {
  cd "$pkgname-$pkgver"

  ./autogen.sh
}

build() {
  cd "$pkgname-$pkgver"

  ./configure --prefix=/usr --mandir=/usr/share/man

  make
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install
}

