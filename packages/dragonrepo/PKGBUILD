pkgname=dragonrepo
pkgver=1.0.1
pkgrel=1
pkgdesc='Automated penetration testing report generator with command tracking and evidence.'
arch=('any')
groups=('blackarch' 'blackarch-reporting')
url='https://github.com/12hrformat/dragonrepo'
license=('MIT')
depends=('python' 'python-typer' 'python-rich' 'python-jinja' 'python-markdown')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('09b13ceea5cddf9119d800a7aaae2a37cafb3be5b8c98075ecbf68a78e9cd4d43f592f663f35c6a987cb6144582d38a2ff6e976aeef117c7a4808120056d314a')

build() {
  cd "$pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

