# See COPYING for license details.

pkgname=deepzero
pkgver=deepzero.v0.4.0.r3.gcdf4e7c
pkgrel=1
pkgdesc='Find zero-days while you sleep. DeepZero is an automated vulnerability research framework that parses, decompiles, and analyzes thousands of Windows kernel drivers for exploitable IOCTLs natively using AI agents.'
arch=('any')
groups=('blackarch' 'blackarch-ai' 'blackarch-automation')
url='https://github.com/416rehman/DeepZero'
license=('MIT')
depends=('python' 'python-click' 'python-rich' 'python-yaml' 'python-jinja' 'python-dotenv')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("git+https://github.com/416rehman/$pkgname.git")
sha512sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v\([0-9]\)/\1/;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd $pkgname

  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname

  python -m installer --destdir="$pkgdir" dist/*.whl

  # Reference pipelines and example processors. These are resolved relative to
  # the working directory at runtime, so they are shipped as examples for the
  # user to copy into their project dir, not as auto-discovered data.
  install -dm 755 "$pkgdir/usr/share/$pkgname/examples"
  cp -a pipelines processors "$pkgdir/usr/share/$pkgname/examples/"

  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

