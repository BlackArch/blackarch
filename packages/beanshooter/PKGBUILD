pkgname=beanshooter
pkgver=4.1.0
pkgrel=1
groups=('blackarch' 'blackarch-exploitation' 'blackarch-scanner')
pkgdesc='JMX enumeration and attacking tool.'
arch=('any')
url='https://github.com/qtc-de/beanshooter'
license=('GPL3')
depends=('java-runtime')
source=("https://github.com/qtc-de/$pkgname/releases/download/v$pkgver/$pkgname-$pkgver-jar-with-dependencies.jar")
noextract=("$pkgname-$pkgver-jar-with-dependencies.jar")
sha512sums=('af8591446f91235b50605f88f0896e80e876280ff5cebd1d9d2cee586732be43c78a3e8c44a4a5937be825fd52b83eaec0a4d0102e45d02afa557eb8d935382b')

package() {
  install -dm 755 "$pkgdir/usr/bin/"
  install -dm 755 "$pkgdir/usr/share/$pkgname"

  install -Dm 644 "$pkgname-$pkgver-jar-with-dependencies.jar" \
    "$pkgdir/usr/share/$pkgname/$pkgname.jar"

  cat > "$pkgdir/usr/bin/$pkgname" << EOF
#!/bin/sh
exec java -jar /usr/share/$pkgname/$pkgname.jar "\$@"
EOF

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

