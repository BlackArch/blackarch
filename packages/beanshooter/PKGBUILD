# See COPYING for license details.

pkgname=beanshooter
pkgver=v4.1.0.r0.gfd37fa7
pkgrel=1
pkgdesc='JMX enumeration and attacking tool.'
arch=('any')
groups=('blackarch' 'blackarch-exploitation' 'blackarch-scanner')
url='https://github.com/qtc-de/beanshooter'
license=('GPL3')
depends=('java-runtime')
makedepends=('maven' 'git')
source=("git+https://github.com/qtc-de/$pkgname.git")
sha512sums=('SKIP')

pkgver() {
  cd $pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd $pkgname

  mvn clean package -DskipTests
}

package() {
  cd $pkgname

  install -dm 755 "$pkgdir/usr/bin"

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" *.md
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/docs/" docs/*.md

  install -Dm 755 target/$pkgname-*-jar-with-dependencies.jar \
    "$pkgdir/usr/share/$pkgname/$pkgname.jar"

  cat > "$pkgdir/usr/bin/$pkgname" << EOF
#!/bin/sh
exec java -jar /usr/share/$pkgname/$pkgname.jar "\$@"
EOF

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

