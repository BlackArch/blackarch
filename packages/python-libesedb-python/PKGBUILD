pkgname=python-libesedb-python
_pkgname=libesedb-python
pkgver=20260704
pkgrel=1
pkgdesc='Library and tools to access the Extensible Storage Engine (ESE) Database File (EDB) format.'
url='https://pypi.org/project/libesedb-python/#files'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
replaces=('python-libesedb')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('f595583e43f76553200492ba8c92214527ee88a1d6dc14ce245596fc7be36e5583eeb7d5b37d5191d4cb1be3f56f8399cdc3541eef55478b4d3514c946ebd971')

build() {
  cd "libesedb-$pkgver"

  python setup.py build
}

package() {
  cd "libesedb-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

