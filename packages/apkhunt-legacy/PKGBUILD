pkgname=apkhunt-legacy
_pkgname="${pkgname%-legacy}"
pkgver=102.386a0d5 # after this commit comes v2.0 which is a full rewrite from go to python and CLI to web server
_commit=386a0d54eac9bdcb0c08573c296aefb84e903ef0
pkgrel=1
pkgdesc='Static code analysis tool for Android apps that is based on the OWASP MASVS framework.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-mobile' 'blackarch-code-audit')
url='https://github.com/Cyber-Buddy/apkhunt'
license=('GPL-3.0-only')
depends=('dex2jar')
makedepends=('git' 'go')
source=("git+https://github.com/Cyber-Buddy/$_pkgname.git#commit=$_commit")
sha512sums=('SKIP')

pkgver() {
  cd $_pkgname

  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null |
      sed 's/^v\([0-9]\)/\1/;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "%s.%s" "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd $_pkgname

  GOPATH="$srcdir" go mod init go.mod
  GOPATH="$srcdir" go mod tidy
  GOPATH="$srcdir" go mod download
  GOPATH="$srcdir" go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-s -w" \
    -o $_pkgname .
}

package() {
  cd $_pkgname

  install -Dm 755 $_pkgname "$pkgdir/usr/bin/$_pkgname"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$_pkgname/" README.md
}

