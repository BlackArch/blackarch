pkgname=morxkeyfmt
pkgver=1.0
pkgrel=5
pkgdesc='Read a private key from stdin and output formatted data values.'
arch=('any')
groups=('blackarch' 'blackarch-crypto')
url='https://www.morxploit.com/tools/'
license=('custom:unknown')
depends=('python2')
source=('https://www.morxploit.com/morxtools/keyfmt')
sha512sums=('93ae0f181555c1e30c2bc71a4d911296dc0de1aed7417040255ca9071e84fb8309e83406ed1c7974922e08d67072a2a8dc805c78b8bb65e90a25655416a17fa9')

prepare() {
  sed -i 's|/usr/bin/env python|/usr/bin/env python2|' keyfmt
}

package() {
  install -Dm 755 keyfmt "$pkgdir/usr/bin/$pkgname"
}

