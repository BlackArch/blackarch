pkgname=vamp-jwt-audit
_pyname=vamp_jwt_audit
pkgver=1.6.0
pkgrel=1
pkgdesc='JWT security auditor covering alg=none, RS256-to-HS256 confusion, HMAC brute force and kid/jku injection'
groups=('blackarch' 'blackarch-scanner' 'blackarch-webapp')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-jwt-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('58fb24ee7ef3379f125b90bdd3e74c5060890f3eda92aa04f20d949973a7e4c57526753395a0242819c54034e8f4ebaa06578bda8c96fcc3b65c25021ccd806d')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

