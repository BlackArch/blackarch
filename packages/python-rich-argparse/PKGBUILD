pkgname=python-rich-argparse
_pkgname=rich_argparse
pkgver=1.8.0
pkgrel=1
pkgdesc='Rich help formatters for argparse and optparse.'
arch=('any')
url='https://github.com/hamdanal/rich-argparse'
license=('MIT')
depends=('python' 'python-rich' 'python-hatchling')
makedepends=('python-build' 'python-pip')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('5cab14a965a3349ae7cce3776dad53b7038e941da5b4c8715819d6448eb45f6c8e992feea94abebe04f5fcd5b618248ba008d4b81f4edccff410eb102bb7afe7')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd "$_pkgname-$pkgver"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $_pkgname
}

