pkgname=xsser
pkgver=1.9
pkgrel=1
epoch=2
groups=('blackarch' 'blackarch-webapp' 'blackarch-fuzzer'
        'blackarch-exploitation')
pkgdesc='A penetration testing tool for detecting and exploiting XSS vulnerabilites.'
arch=('any')
url='https://xsser.03c8.net/'
license=('GPL3')
depends=('python' 'python-beautifulsoup4' 'python-pycurl' 'python-selenium'
         'python-ddgs' 'python-fpdf2'
         'python-pycurl' 'python-geoip') # 'orbited' 'python-twisted'  'python-cairo' 'python-gobject' 'python-cffi'
         # python-gi
makedepends=('python-setuptools')
optdepends=('pygtkmoz' 'pygtk')
source=("https://github.com/epsylon/xsser/releases/download/xsser-v1.9/${pkgname}-${pkgver}.tar.gz")
sha512sums=('ba70ccc434ae7f9cbbb1ee66301851f743878bf8c3df355bf49b358787e4af6bad1bb939375f01a392af81986da8562053b72178a06b42a638070f31733efd11')

package() {
  cd "$pkgname-v$pkgver"

  install -dm 755 "$pkgdir/usr/bin"
  install -dm 755 "$pkgdir/usr/share/$pkgname"

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" doc/*
  rm -rf doc

  cp -a * "$pkgdir/usr/share/$pkgname/"

  cat > "$pkgdir/usr/bin/$pkgname" << EOF
#!/bin/sh
cd /usr/share/$pkgname
exec python $pkgname "\$@"
EOF

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

