pkgname=vamp-docker-audit
_pyname=vamp_docker_audit
pkgver=1.7.0
pkgrel=1
pkgdesc='Docker and container security auditor for authorized assessments — image layers, capabilities, secrets and runtime config'
groups=('blackarch' 'blackarch-scanner' 'blackarch-cloud')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-docker-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('b6a039f89a3647552c3eb08ce391be8eb9f9b974d90a14a71e6589071d7a4776675243624fe73cd4e571336ce7ca7834c575c3c64db7468052fbac1fa1135bae')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

