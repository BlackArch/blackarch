pkgname=vamp-docker-audit
_pyname=vamp_docker_audit
pkgver=1.3
pkgrel=1
pkgdesc='Docker and container security auditor for authorized assessments — image layers, capabilities, secrets and runtime config'
groups=('blackarch' 'blackarch-scanner' 'blackarch-cloud')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-docker-audit'
license=('AGPL-3.0-only')
depends=('python' 'python-rich')
makedepends=('python-build' 'python-pip' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('07c6a5338538933f6fdd81b3d6acfea3021c5d9838b6b779bae675ad1d33de5826d5e7e0c66b1454020577f75c7900169943efe35a7b5254ba36056d6e4fed20')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd "${_pyname}-${pkgver}"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $pkgname
}

