pkgname=vamp-docker-audit
_pyname=vamp_docker_audit
pkgver=1.6.0
pkgrel=1
pkgdesc='Docker and container security auditor for authorized assessments — image layers, capabilities, secrets and runtime config'
groups=('blackarch' 'blackarch-scanner' 'blackarch-cloud')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-docker-audit'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('f2031bdea54e0cda6282aed564653a8a2310977ab79e4fb5c8302d3849164d120374d9e81d194c2f008450e5b837a1274ec7796dfb03de89eaa76fe7072efc88')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

