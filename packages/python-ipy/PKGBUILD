pkgname=python-ipy
_pkgname=IPy
pkgver=1.2
pkgrel=1
pkgdesc='Class and tools for handling of IPv4 and IPv6 addresses and networks.'
arch=('any')
url='https://pypi.org/project/IPy/'
license=('BSD')
depends=('python')
makedepends=('python-setuptools')
checkdepends=('python-pytest')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('30c82c07a040e50c2df7f6b28d6b9438aa082531689e9968bea741f58cdd3d96ad6aa2266a71ce91f487ea3f859c8e40fee0aa3608c326ed8102cf7ada42d13c')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build

  install -vDm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
  install -vDm 644 {AUTHORS,ChangeLog,README.rst} \
    -t "$pkgdir/usr/share/doc/$pkgname"
}

