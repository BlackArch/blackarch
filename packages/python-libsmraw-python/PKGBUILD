pkgname=python-libsmraw-python
_pkgname=libsmraw
__pkgname="${_pkgname}-python"
pkgver=20260902
pkgrel=1
pkgdesc='Library and tools to access the (split) RAW image format.'
url='https://pypi.org/project/libsmraw-python/'
arch=('x86_64' 'aarch64')
license=('LGPL3')
depends=('python')
makedepends=('python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$__pkgname/$_pkgname-python-$pkgver.tar.gz")
sha512sums=('a81e93ad54d979c99ac7766ff331d81342e28791d29500995f414870b24cae0f88bb33bb18445a2f92086eb01ef8a060c2509505fc77314a0184023f2ffcd056')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build
}

