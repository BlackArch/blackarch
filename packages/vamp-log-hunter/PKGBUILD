pkgname=vamp-log-hunter
_pyname=vamp_log_hunter
pkgver=1.3
pkgrel=1
pkgdesc='Log hunting and threat-pattern scanner for authorized security assessments with fast-mode triage'
groups=('blackarch' 'blackarch-forensic')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-log-hunter'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('5e7a32eff8f292ae1940eddd4497fef14fd3b4ab75029649a4b97e0a828eae02469ae52710b8694e7a8fd3f0f224395336bf6a6616a11cbff73598b9f49742a6')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

