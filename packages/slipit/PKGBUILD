pkgname=slipit
pkgver=1.0.1
pkgrel=1
pkgdesc='Utility for creating archives with path traversal elements for ZipSlip attacks.'
arch=('any')
groups=('blackarch' 'blackarch-misc')
url='https://github.com/usdAG/slipit'
license=('GPL-3.0-only')
depends=('python' 'python-magic')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/$pkgname/$pkgname-$pkgver.tar.gz")
sha512sums=('d7ca53147c12c96ee2a5546f7e522229a744f0c4cd7897bd0ccc41d42475dfdfdff6888f2d962c278c6d8457c0b16e3695f4225f0c2b825682475f43e8131d78')

build() {
  cd "$pkgname-$pkgver"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

