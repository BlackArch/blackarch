pkgname=asleap
pkgver=2.5
pkgrel=1
groups=('blackarch' 'blackarch-cracker')
pkgdesc='Cisco LEAP and generic MS-CHAPv2 dictionary Attack.'
arch=('x86_64' 'aarch64')
license=('GPL-2.0-or-later')
url='https://github.com/OscarAkaElvis/asleap'
depends=('libpcap')
source=("https://github.com/OscarAkaElvis/$pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('36774541b4db1e07f328db266192678df047e888d872aeda7707d11324b17c865118fe83c904b056aa7d18b5df3731ab3051bf6fd23c543565b580aeb8980e31')

build() {
  cd "$pkgname-$pkgver"

  make
}

package() {
  cd "$pkgname-$pkgver"

  install -dm 755 "$pkgdir/usr/share/doc/$pkgname/"

  make DESTDIR="$pkgdir" DOCDIR="/usr/share/doc/$pkgname/" install
}

