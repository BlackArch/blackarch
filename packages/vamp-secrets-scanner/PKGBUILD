pkgname=vamp-secrets-scanner
_pyname=vamp_secrets_scanner
pkgver=3.2.0
pkgrel=1
pkgdesc='Static secrets and credentials scanner with git history analysis, Shannon entropy detection and SARIF 2.1.0 output'
groups=('blackarch' 'blackarch-scanner' 'blackarch-code-audit')
arch=('any')
url='https://github.com/Vampsecure-Labs/vamp-secrets-scanner'
license=('AGPL-3.0-only')
options=(!emptydirs)
depends=('python' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/${pkgname::1}/${pkgname}/${_pyname}-${pkgver}.tar.gz")
sha512sums=('406bed686d1c86332123242bdaaf881790471fa7145df5fe67a2b69c1267d28d918cc2772a4e1e7144af03272f5bda9923d13f11ee4d74b6fd901456892b7e79')

build() {
  cd "${_pyname}-${pkgver}"

  python -m build --wheel --no-isolation
}

package() {
  cd "${_pyname}-${pkgver}"

  python -m installer --destdir="$pkgdir" dist/*.whl
}

