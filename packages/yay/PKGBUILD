pkgname=yay
pkgver=13.1.0
pkgrel=1
pkgdesc='Yet another yogurt. Pacman wrapper and AUR helper written in go.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-misc')
url='https://github.com/Jguer/yay'
license=('GPL-3.0-or-later')
depends=('pacman' 'git')
makedepends=('go>=1.24')
optdepends=('sudo' 'doas')
source=("https://github.com/Jguer/$pkgname/archive/v$pkgver.tar.gz")
sha512sums=('b3bef661cbc9965d68d198875538dd220e09f56e59a11d3ab2582723e52729d2bc6d18ccaa6af94cd2950af1bf954e09ee518056a112e27113f252a3ea637d50')

build() {
  export GOPATH="$srcdir"/gopath
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export CGO_ENABLED=1

  cd "$pkgname-$pkgver"

  make VERSION=$pkgver DESTDIR="$pkgdir" PREFIX=/usr build
}

package() {
  cd "$pkgname-$pkgver"

  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr install
}

