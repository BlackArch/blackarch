pkgname=python-pywavelets
_pkgname=${pkgname#python-}
pkgver=1.10.0
pkgrel=1
pkgdesc='PyWavelets, wavelet transform module.'
arch=('x86_64' 'aarch64')
url='https://pypi.org/project/PyWavelets/#files'
license=('MIT')
depends=('python' 'python-numpy')
makedepends=('python-build' 'python-pip')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('67e14e73024bc0fc79b257a4b58caedab697734831d16e74014b5d77ee0836bbf778bdeba05aea8bfc7869bb4ce1c992735563994e1df60a69ded6f275666983')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd "$_pkgname-$pkgver"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $_pkgname
}

