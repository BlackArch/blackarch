pkgbase=python-pyrtlsdr
pkgname=('python2-pyrtlsdr' 'python-pyrtlsdr')
_pkgname=pyrtlsdr
pkgver=0.5.1
pkgrel=1
epoch=1
pkgdesc="A Python wrapper for librtlsdr (a driver for Realtek RTL2832U based SDR's)."
arch=('any')
url='https://pypi.org/project/pyrtlsdr/#files'
license=('APACHE')
makedepends=('python2-setuptools' 'python-setuptools')
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('5deec064ee4da75a0f78c8f2fcbbdd2fd36fabcdc5e9a347d68f91d1980eff1f2d5e7eb2ddbdc7069e8a852586729e3aed968b8d453071da1d7c9f5c1c07f604')

prepare() {
  cp -a "$_pkgname-$pkgver"{,-2}
}

build() {
  cd "$_pkgname-$pkgver-2"

  python2 setup.py build

  cd "$srcdir/$_pkgname-$pkgver"

  python setup.py build
}

package_python2-pyrtlsdr() {
  depends=('python2' 'python2-m2r')

  cd "$_pkgname-$pkgver-2"

  python2 setup.py install --prefix=/usr --root="$pkgdir" --optimize=1 \
    --skip-build
}

package_python-pyrtlsdr() {
  depends=('python')

  cd "$_pkgname-$pkgver"

  python setup.py install --prefix=/usr --root="$pkgdir" --optimize=1 \
    --skip-build
}

